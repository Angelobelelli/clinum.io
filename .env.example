# ---------------------------------------------------------------------------
# Clinum - variáveis de ambiente (local dev)
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ---------------------------------------------------------------------------

# ---- PostgreSQL (docker-compose) ------------------------------------------
POSTGRES_USER=clinum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clinum
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# String de conexão usada pelo Prisma (apps/api)
DATABASE_URL="postgresql://clinum:change-me@localhost:5432/clinum?schema=public"

# ---- Redis (docker-compose) -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---- API (apps/api) ---------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# ---- Autenticação / multi-tenant (better-auth, apps/api) --------------------
# Chave usada pelo better-auth para assinatura/criptografia. Gere uma nova
# para cada ambiente com `pnpm exec @better-auth/cli secret` (NUNCA reuse
# entre dev/staging/produção).
BETTER_AUTH_SECRET=dev-only-change-me
# URL pública da própria API (usada pelo better-auth para montar callbacks).
BETTER_AUTH_URL="http://localhost:3001"
# Origens confiáveis adicionais, separadas por vírgula. Suporta wildcard de
# subdomínio (ex: para aceitar qualquer subdomínio de clínica em dev/staging).
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://*.localhost:3000"

# ---- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000
