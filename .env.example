# ---------------------------------------------------------------------------
# Clinum - variáveis de ambiente (local dev)
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ---------------------------------------------------------------------------

# ---- PostgreSQL (docker-compose) ------------------------------------------
POSTGRES_USER=clinum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clinum
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Role Postgres RESTRITO (sem SUPERUSER), criado automaticamente por
# docker-init/create-app-role.sh — usado só para as tabelas de NEGÓCIO
# (Patient, etc.), via um Prisma Client separado (ver
# apps/api/src/core/database/tenant-scoped-prisma-client.ts). Necessário
# pra Row-Level Security ter efeito de verdade (superusuário sempre ignora
# RLS).
POSTGRES_APP_USER=clinum_app
POSTGRES_APP_PASSWORD=change-me-too

# String de conexão usada pelo Prisma CLI (migrations/generate) e pelas
# tabelas de auth/tenant já existentes (user/session/organization/member/
# etc.) — continuam no usuário superuser de propósito, ver comentário em
# docker-init/create-app-role.sh.
DATABASE_URL="postgresql://clinum:change-me@localhost:5432/clinum?schema=public"

# String de conexão usada SÓ pelas tabelas de negócio (Patient/
# PatientHealthRecord) — usuário restrito, necessário pra Row-Level
# Security funcionar de verdade.
APP_DATABASE_URL="postgresql://clinum_app:change-me-too@localhost:5432/clinum?schema=public"

# ---- Redis (docker-compose) -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---- API (apps/api) ---------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# ---- Autenticação / multi-tenant (better-auth, apps/api) --------------------
# Chave usada pelo better-auth para assinatura/criptografia. Gere uma nova
# para cada ambiente com `pnpm exec @better-auth/cli secret` (NUNCA reuse
# entre dev/staging/produção).
BETTER_AUTH_SECRET=dev-only-change-me
# URL pública da própria API (usada pelo better-auth para montar callbacks).
BETTER_AUTH_URL="http://localhost:3001"
# Origens confiáveis adicionais, separadas por vírgula. Suporta wildcard de
# subdomínio (ex: para aceitar qualquer subdomínio de clínica em dev/staging).
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://*.localhost:3000"

# ---- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000

# ---- Integração Google Calendar (apps/api) -----------------------------------
# Client ID/Secret do OAuth 2.0 configurado no Google Cloud Console para a
# Google Calendar API (tela de consentimento + credenciais "Web application").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback registrada no Google Cloud Console — precisa bater
# exatamente com a rota GET /google-calendar/oauth/callback da API.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3001/google-calendar/oauth/callback"
# URL pública (https) usada em calendar.events.watch() para o Google enviar
# notificações de mudança — precisa de um túnel (ex: ngrok) em dev, já que
# o Google precisa alcançá-la pela internet.
GOOGLE_CALENDAR_WEBHOOK_URL=
# Chave da criptografia simétrica (AES-256-GCM) dos refresh tokens OAuth
# salvos em GoogleCalendarConnection.refreshTokenEncrypted — base64 de
# exatamente 32 bytes. Gere uma por ambiente com: openssl rand -base64 32
# (NUNCA reuse entre dev/staging/produção, mesmo racional de
# BETTER_AUTH_SECRET).
GOOGLE_TOKEN_ENCRYPTION_KEY=
