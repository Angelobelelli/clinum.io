# ---------------------------------------------------------------------------
# Clinum - variáveis de ambiente (local dev)
# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# ---------------------------------------------------------------------------

# ---- PostgreSQL (docker-compose) ------------------------------------------
POSTGRES_USER=clinum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clinum
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# String de conexão usada pelo Prisma (apps/api)
DATABASE_URL="postgresql://clinum:change-me@localhost:5432/clinum?schema=public"

# ---- Redis (docker-compose) -------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---- API (apps/api) ---------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# ---- Web (apps/web) ----------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000
